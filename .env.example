# Salin ke .env.local lalu isi. Nilai lokal dari `supabase status` (Supabase CLI).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya server/CI. JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (F1). Kunci uji resmi untuk lokal: site key 1x00000000000000000000AA (selalu lolos),
# secret 1x0000000000000000000000000000000AA. Isi di sini hanya setelah F1 dikerjakan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
