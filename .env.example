# Salin ke .env.local lalu isi. Nilai lokal dari `supabase status` (Supabase CLI).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya server/CI. JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (F1). Kunci uji resmi Cloudflare untuk lokal (verifikasi di dokumentasi Cloudflare):
#   site key  1x00000000000000000000AA  widget tampak, selalu lolos
#   site key  1x00000000000000000000BB  widget tak terlihat, selalu lolos
#   secret    1x0000000000000000000000000000000AA  selalu lolos (dipakai Supabase Auth, lihat di bawah)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Supabase Auth membaca secret CAPTCHA dari lingkungan saat `supabase start` (supabase/config.toml: env()).
# Atur di shell atau di supabase/.env sebelum `supabase start`:
# SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
